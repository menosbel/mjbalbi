---
import { siteConfig } from '../../site.config.mjs';
import Seo, { type ImagenSeo } from '../components/Seo.astro';
import { url } from '../lib/urls';
import '../styles/global.css';

// Cada página pasa sus metadatos como props; todos tienen un valor por defecto,
// pero title y description deben ser únicos por página (lo verifica test/seo.test.mjs).
interface Props {
  /** Título de la página; el nombre de la artista se agrega al final. Sin título: solo el nombre. */
  title?: string;
  /** Meta description. Por defecto, la descripción del sitio (siteConfig.descripcion). */
  description?: string;
  /** Imagen para compartir en redes ({ src: ImageMetadata, alt }). */
  image?: ImagenSeo;
  /** og:type; 'website' por defecto. */
  type?: string;
  /** Datos estructurados schema.org (JSON-LD): un objeto o una lista. */
  jsonLd?: object | object[];
}

const { title, description = siteConfig.descripcion, image, type, jsonLd } = Astro.props;
const fullTitle = title ? `${title} · ${siteConfig.artista}` : siteConfig.artista;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <Seo title={fullTitle} description={description} image={image} type={type} jsonLd={jsonLd} />
  </head>
  <body>
    <header class="contenedor encabezado">
      <a href={url('/')}>{siteConfig.artista}</a>
    </header>
    <main class="contenedor">
      <slot />
    </main>
  </body>
</html>

<style>
  .encabezado {
    padding-block: 1.25rem;
  }

  .encabezado a {
    font-family: var(--fuente-titulos);
    font-size: 1.25rem;
    color: var(--color-texto);
    text-decoration: none;
  }
</style>
