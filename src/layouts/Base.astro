---
import { siteConfig } from '../../site.config.mjs';
import { mailto } from '../lib/consulta';
import { url } from '../lib/urls';
import '../styles/global.css';

interface Props {
  /** Título de la página; el nombre de la artista se agrega al final. */
  title?: string;
}

const { title } = Astro.props;
const instagram = `https://www.instagram.com/${siteConfig.instagram}/`;
const fullTitle = title ? `${title} · ${siteConfig.artista}` : siteConfig.artista;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="contenedor encabezado">
      <a href={url('/')}>{siteConfig.artista}</a>
    </header>
    <main class="contenedor">
      <slot />
    </main>
    <footer class="contenedor pie">
      <a href={mailto()}>{siteConfig.email}</a>
      <a href={instagram} rel="me">Instagram @{siteConfig.instagram}</a>
    </footer>
  </body>
</html>

<style>
  .encabezado {
    padding-block: 1.25rem;
  }

  .encabezado a {
    font-family: var(--fuente-titulos);
    font-size: 1.25rem;
    color: var(--color-texto);
    text-decoration: none;
  }

  .pie {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-block: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--color-secundario) 30%, transparent);
    font-size: 0.9375rem;
  }
</style>
