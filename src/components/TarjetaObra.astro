---
// Una Obra en una grilla (galería, Serie, inicio): un figure con la foto principal
// y, como figcaption, el título y el Estado; todo dentro de un link a su página.
// Va dentro de un <li>.
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import EtiquetaEstado from './EtiquetaEstado.astro';
import { urlObra } from '../lib/urls';

interface Props {
  obra: CollectionEntry<'obras'>;
  /** true solo para la primera imagen de la página: se carga enseguida y con prioridad. */
  eager?: boolean;
}

const { obra, eager = false } = Astro.props;
const { titulo, fotos, estado } = obra.data;
const [foto] = fotos;
// Columnas de la grilla: 1 en el celular, 2 desde 36rem, 3 desde 64rem.
const sizes = '(min-width: 64rem) 33vw, (min-width: 36rem) 50vw, 100vw';
const MAX = 1200;
// Nunca se agranda una foto: los tamaños llegan hasta el ancho del original.
const widths = [...[360, 480, 800].filter((w) => w < foto.src.width), Math.min(foto.src.width, MAX)];
---

<a class="tarjeta" href={urlObra(obra.id)}>
  <figure>
    <Picture
      src={foto.src}
      alt={foto.alt}
      widths={widths}
      sizes={sizes}
      formats={['webp']}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
    />
    <figcaption>
      <h2>{titulo}</h2>
      <EtiquetaEstado estado={estado} />
    </figcaption>
  </figure>
</a>

<style>
  .tarjeta {
    color: inherit;
    text-decoration: none;
  }

  figure,
  figcaption {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }

  .tarjeta :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: #eee9e0;
  }

  h2 {
    margin: 0;
    font-size: 1.25rem;
  }

  .tarjeta:hover h2 {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
