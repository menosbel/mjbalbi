---
// Datos estructurados schema.org Person de la artista (nombre, sitio e Instagram).
import { siteConfig } from '../../site.config.mjs';
import { absoluta, serializarJsonLd } from '../lib/seo';
import { url, urlInstagram } from '../lib/urls';

const persona = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.artista,
  url: absoluta(url('/')),
  sameAs: [urlInstagram()],
};
---

<script type="application/ld+json" set:html={serializarJsonLd(persona)} />
