---
// Metadatos de buscadores y redes de cada página: title, description,
// canonical, Open Graph, Twitter Card y JSON-LD. Lo usa el layout Base; las
// páginas le pasan sus datos como props de <Base> (ver Base.astro).
import type { ImageMetadata } from 'astro';
import { siteConfig } from '../../site.config.mjs';
import { absoluta, imagenParaCompartir, serializarJsonLd } from '../lib/seo';

export interface ImagenSeo {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  title: string;
  description: string;
  /** og:type: 'website' por defecto; 'article' para una página de contenido. */
  type?: string;
  /** Imagen para compartir (Open Graph / Twitter). */
  image?: ImagenSeo;
  /** Datos estructurados schema.org: un objeto o una lista. */
  jsonLd?: object | object[];
}

const { title, description, type = 'website', image, jsonLd } = Astro.props;
// Astro.url.pathname ya incluye el base path.
const canonical = absoluta(Astro.url.pathname);
const imagen = image && (await imagenParaCompartir(image.src));
const datos = jsonLd === undefined ? [] : [jsonLd].flat();
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={type} />
<meta property="og:locale" content="es_AR" />
<meta property="og:site_name" content={siteConfig.artista} />
{
  imagen && image && (
    <>
      <meta property="og:image" content={imagen.url} />
      <meta property="og:image:width" content={String(imagen.width)} />
      <meta property="og:image:height" content={String(imagen.height)} />
      <meta property="og:image:alt" content={image.alt} />
      <meta name="twitter:image" content={imagen.url} />
      <meta name="twitter:image:alt" content={image.alt} />
    </>
  )
}
<meta name="twitter:card" content={imagen ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{datos.map((d) => <script is:inline type="application/ld+json" set:html={serializarJsonLd(d)} />)}
