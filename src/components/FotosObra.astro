---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  fotos: { src: ImageMetadata; alt: string }[];
}

const { fotos } = Astro.props;
// Mobile first: a todo el ancho; desde 64rem, la columna de fotos ocupa ~60% de la pantalla.
const sizes = '(min-width: 64rem) 60vw, 100vw';
const WIDTHS = [480, 800, 1200, 1600, 2400];
// Nunca se agranda una foto: los tamaños llegan hasta el ancho del original.
const widthsFor = (src: ImageMetadata) => [...WIDTHS.filter((w) => w < src.width), src.width];
---

<div class="fotos">
  {
    fotos.map((foto, i) => (
      <figure>
        <Picture
          src={foto.src}
          alt={foto.alt}
          widths={widthsFor(foto.src)}
          sizes={sizes}
          formats={['webp']}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
        />
      </figure>
    ))
  }
</div>
