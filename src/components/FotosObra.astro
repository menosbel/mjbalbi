---
import { Picture } from 'astro:assets';
import { anchosResponsivos } from '../lib/imagenes';
import type { Foto } from '../lib/obras';

interface Props {
  /** Título de la Obra, para el pie de cada foto. */
  titulo: string;
  fotos: Foto[];
}

const { titulo, fotos } = Astro.props;
// Pie de cada foto: el título; si hay varias, también cuál es ("2 de 3").
const pie = (i: number) => (fotos.length > 1 ? `${titulo} (${i + 1} de ${fotos.length})` : titulo);
// Mobile first: a todo el ancho; desde 64rem, la columna de fotos ocupa ~60% de la pantalla.
const SIZES = '(min-width: 64rem) 60vw, 100vw';
const ANCHOS = [480, 800, 1200, 1600, 2400];
---

<div class="fotos">
  {
    fotos.map((foto, i) => (
      <figure>
        <Picture
          src={foto.src}
          alt={foto.alt}
          widths={anchosResponsivos(foto, ANCHOS)}
          sizes={SIZES}
          formats={['webp']}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
        />
        <figcaption>{pie(i)}</figcaption>
      </figure>
    ))
  }
</div>

<style>
  .fotos {
    display: grid;
    gap: 1rem;
  }

  figure {
    display: grid;
    gap: 0.375rem;
    margin: 0;
  }

  figcaption {
    color: var(--color-secundario);
    font-size: 0.875rem;
  }
</style>
