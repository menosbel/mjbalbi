---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  /** Título de la Obra, para el pie de cada foto. */
  titulo: string;
  fotos: { src: ImageMetadata; alt: string }[];
}

const { titulo, fotos } = Astro.props;
// Pie de cada foto: el título; si hay varias, también cuál es ("2 de 3").
const pie = (i: number) => (fotos.length > 1 ? `${titulo} (${i + 1} de ${fotos.length})` : titulo);
// Mobile first: a todo el ancho; desde 64rem, la columna de fotos ocupa ~60% de la pantalla.
const sizes = '(min-width: 64rem) 60vw, 100vw';
const WIDTHS = [480, 800, 1200, 1600, 2400];
// Nunca se agranda una foto: los tamaños llegan hasta el ancho del original.
const widthsFor = (src: ImageMetadata) => [...WIDTHS.filter((w) => w < src.width), src.width];
---

<div class="fotos">
  {
    fotos.map((foto, i) => (
      <figure>
        <Picture
          src={foto.src}
          alt={foto.alt}
          widths={widthsFor(foto.src)}
          sizes={sizes}
          formats={['webp']}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
        />
        <figcaption>{pie(i)}</figcaption>
      </figure>
    ))
  }
</div>

<style>
  .fotos {
    display: grid;
    gap: 1rem;
  }

  figure {
    display: grid;
    gap: 0.375rem;
    margin: 0;
  }

  figcaption {
    color: var(--color-secundario);
    font-size: 0.875rem;
  }
</style>
