---
import { getCollection, render } from 'astro:content';
import GrillaObras from '../../components/GrillaObras.astro';
import Base from '../../layouts/Base.astro';
import { siteConfig } from '../../../site.config.mjs';
import { obrasDeSerie } from '../../lib/obras';
import { ordenGaleria } from '../../lib/orden';
import { textoPlano } from '../../lib/seo';

export async function getStaticPaths() {
  const series = await getCollection('series');
  return series.map((serie) => ({ params: { slug: serie.id }, props: { serie } }));
}

const { serie } = Astro.props;
const { Content } = await render(serie);
const obras = obrasDeSerie(ordenGaleria(await getCollection('obras')), serie.id);
---

<Base
  title={serie.data.nombre}
  description={`Serie ${serie.data.nombre}, de ${siteConfig.artista}. ${textoPlano(serie.body)}`.trim()}
  image={obras[0]?.data.fotos[0]}
>
  <article class="serie">
    <h1>{serie.data.nombre}</h1>
    <div class="texto">
      <Content />
    </div>
    <div class="obras">
      <GrillaObras obras={obras} />
    </div>
  </article>
</Base>

<style>
  .serie {
    padding-bottom: 3rem;
  }

  .texto {
    max-width: 40rem;
  }

  .obras {
    margin-top: 2rem;
  }
</style>
