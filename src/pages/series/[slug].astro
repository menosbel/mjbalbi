---
import { getCollection, render } from 'astro:content';
import TarjetaObra from '../../components/TarjetaObra.astro';
import Base from '../../layouts/Base.astro';
import { ordenGaleria } from '../../lib/orden';

export async function getStaticPaths() {
  const series = await getCollection('series');
  return series.map((serie) => ({ params: { slug: serie.id }, props: { serie } }));
}

const { serie } = Astro.props;
const { Content } = await render(serie);
const obras = ordenGaleria(await getCollection('obras', (obra) => obra.data.serie?.id === serie.id));
---

<Base title={serie.data.nombre}>
  <article class="serie">
    <h1>{serie.data.nombre}</h1>
    <div class="texto">
      <Content />
    </div>
    <ul class="obras">
      {
        obras.map((obra) => (
          <li>
            <TarjetaObra obra={obra} />
          </li>
        ))
      }
    </ul>
  </article>
</Base>

<style>
  .serie {
    padding-bottom: 3rem;
  }

  .texto {
    max-width: 40rem;
  }

  /* Misma grilla que la galería: 1 columna en el celular, 2 desde 36rem, 3 desde 64rem. */
  .obras {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem 1.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 36rem) {
    .obras {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .obras {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
