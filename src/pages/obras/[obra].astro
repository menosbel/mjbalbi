---
import { Image, getImage } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { ARTISTA, ESTADOS, TECNICAS } from '../../config';
import {
  mailtoConsulta,
  medidas,
  obras,
  tecnicaYSoporte,
  url,
  urlAbsoluta,
  urlObra,
  urlSerie,
  urlTecnica,
  type Obra,
} from '../../lib/sitio';

export async function getStaticPaths() {
  const todas = await obras();
  return todas.map((obra, i) => {
    // /obras/<técnica>/ es el listado filtrado: una Obra no puede usar ese nombre de carpeta.
    if (obra.id in TECNICAS) throw new Error(`La carpeta de la Obra "${obra.id}" choca con una Técnica; renombrala.`);
    return {
      params: { obra: obra.id },
      props: { obra, anterior: todas[i - 1], siguiente: todas[i + 1] },
    };
  });
}

interface Props {
  obra: Obra;
  anterior?: Obra;
  siguiente?: Obra;
}

const { obra, anterior, siguiente } = Astro.props;
const { data } = obra;
const { Content } = await render(obra);
const serie = data.serie ? await getEntry(data.serie) : undefined;
const site = Astro.site;
const urlPagina = urlAbsoluta(urlObra(obra), site);
const grande = await getImage({ src: data.foto, width: Math.min(2400, data.foto.width), format: 'jpg' });

const descripcion = `${data.titulo}, ${tecnicaYSoporte(obra).toLowerCase()} de ${medidas(obra)}${data.anio ? ` (${data.anio})` : ''}, obra original de ${ARTISTA.nombre}. ${ESTADOS[data.estado]}.`;

const artworkJsonLd = {
  '@type': 'VisualArtwork',
  '@id': `${urlPagina}#obra`,
  name: data.titulo,
  url: urlPagina,
  image: urlAbsoluta(grande.src, site),
  description: obra.body?.trim() || descripcion,
  creator: { '@id': urlAbsoluta(url('/#artista'), site) },
  artform: 'Pintura',
  artMedium: TECNICAS[data.tecnica].nombre,
  artworkSurface: data.soporte,
  width: { '@type': 'QuantitativeValue', value: data.ancho, unitCode: 'CMT', unitText: 'cm' },
  height: { '@type': 'QuantitativeValue', value: data.alto, unitCode: 'CMT', unitText: 'cm' },
  ...(data.anio && { dateCreated: String(data.anio) }),
  ...(serie && { isPartOf: { '@type': 'CreativeWorkSeries', name: serie.data.nombre, url: urlAbsoluta(urlSerie(serie), site) } }),
  inLanguage: 'es-AR',
};

const migas = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Obras', item: urlAbsoluta(url('/obras/'), site) },
    { '@type': 'ListItem', position: 2, name: TECNICAS[data.tecnica].plural, item: urlAbsoluta(urlTecnica(data.tecnica), site) },
    { '@type': 'ListItem', position: 3, name: data.titulo, item: urlPagina },
  ],
};
---

<Base titulo={data.titulo} descripcion={descripcion} imagen={data.foto} imagenAlt={data.alt} tipo="article" jsonLd={[artworkJsonLd, migas]}>
  <nav class="migas" aria-label="Migas de pan">
    <a href={url('/obras/')}>Obras</a>
    <span aria-hidden="true">/</span>
    <a href={urlTecnica(data.tecnica)}>{TECNICAS[data.tecnica].nombre}</a>
  </nav>

  <article class="obra">
    <figure class="obra-foto">
      <a href={grande.src} title="Ver en alta resolución">
        <Image
          src={data.foto}
          alt={data.alt}
          widths={[600, 1000, 1400, 1800]}
          sizes="(min-width: 960px) 62vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </a>
    </figure>

    <div class="obra-info">
      <h1>{data.titulo}</h1>
      <dl class="ficha">
        <dt>Técnica</dt>
        <dd>{tecnicaYSoporte(obra)}</dd>
        <dt>Medidas</dt>
        <dd>{medidas(obra)} <span class="tenue">(ancho × alto)</span></dd>
        {data.anio && (<><dt>Año</dt><dd>{data.anio}</dd></>)}
        {serie && (<><dt>Serie</dt><dd><a href={urlSerie(serie)}>{serie.data.nombre}</a></dd></>)}
        <dt>Estado</dt>
        <dd><span class={`estado estado-${data.estado}`}>{ESTADOS[data.estado]}</span></dd>
      </dl>

      <div class="descripcion">
        <Content />
      </div>

      {
        data.estado === 'vendida' ? (
          <p class="tenue">
            Esta obra ya tiene dueño. Si te gusta, <a href={mailtoConsulta(obra, urlPagina)}>escribime</a>: puedo contarte
            sobre obras similares.
          </p>
        ) : (
          <a class="boton" href={mailtoConsulta(obra, urlPagina)}>
            Consultar precio y disponibilidad
          </a>
        )
      }
      <p class="tenue pequeno">Obra original firmada. Envíos a coordinar.</p>
    </div>
  </article>

  <nav class="paginacion" aria-label="Otras obras">
    {anterior ? <a href={urlObra(anterior)} rel="prev">← {anterior.data.titulo}</a> : <span />}
    {siguiente ? <a href={urlObra(siguiente)} rel="next">{siguiente.data.titulo} →</a> : <span />}
  </nav>
</Base>
