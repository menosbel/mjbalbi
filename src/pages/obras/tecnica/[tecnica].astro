---
// Vista filtrada de la galería: solo las Obras de una Técnica.
import { getCollection } from 'astro:content';
import Galeria from '../../../components/Galeria.astro';
import Base from '../../../layouts/Base.astro';
import { filtrosGaleria, slugTecnica } from '../../../lib/filtros';
import { tecnicasConObras } from '../../../lib/obras';
import { ordenGaleria } from '../../../lib/orden';
import { siteConfig } from '../../../../site.config.mjs';

export async function getStaticPaths() {
  return tecnicasConObras(await getCollection('obras')).map((tecnica) => ({
    params: { tecnica: slugTecnica(tecnica) },
    props: { tecnica },
  }));
}

const { tecnica } = Astro.props;
const todas = ordenGaleria(await getCollection('obras'));
const filtros = await filtrosGaleria(todas);
const obras = todas.filter((o) => o.data.tecnica === tecnica);
const titulo = `Obras en ${tecnica}`;
---

<Base title={titulo} description={`Obras de ${siteConfig.artista} pintadas en ${tecnica}.`} image={obras[0]?.data.fotos[0]}>
  <h1>{titulo}</h1>
  <Galeria obras={obras} filtros={filtros} />
</Base>
