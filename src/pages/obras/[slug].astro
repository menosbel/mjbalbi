---
import { getCollection, render } from 'astro:content';
import FotosObra from '../../components/FotosObra.astro';
import Base from '../../layouts/Base.astro';
import { ETIQUETA_ESTADO, ETIQUETA_TECNICA, formatMedidas } from '../../lib/obras';

export async function getStaticPaths() {
  const obras = await getCollection('obras');
  return obras.map((obra) => ({ params: { slug: obra.id }, props: { obra } }));
}

const { obra } = Astro.props;
const { titulo, fotos, medidas, tecnica, soporte, año, enmarcada, estado } = obra.data;
const { Content } = await render(obra);

const datos: [string, string][] = [
  ['Medidas', formatMedidas(medidas)],
  ['Técnica', ETIQUETA_TECNICA[tecnica]],
  ...(soporte ? [['Soporte', capitalize(soporte)] as [string, string]] : []),
  ['Año', String(año)],
  ...(enmarcada !== undefined ? [['Enmarcada', enmarcada ? 'Sí' : 'No'] as [string, string]] : []),
];

function capitalize(text: string) {
  return text.charAt(0).toLocaleUpperCase('es') + text.slice(1);
}
---

<Base title={titulo}>
  <article class="obra">
    <FotosObra fotos={fotos} />
    <div class="ficha">
      <h1>{titulo}</h1>
      <p class={`estado estado-${estado}`}>{ETIQUETA_ESTADO[estado]}</p>
      <dl>
        {
          datos.map(([termino, valor]) => (
            <>
              <dt>{termino}</dt>
              <dd>{valor}</dd>
            </>
          ))
        }
      </dl>
      <div class="descripcion">
        <Content />
      </div>
      <p class="precio">Consultar precio</p>
    </div>
  </article>
</Base>

<style>
  .obra {
    display: grid;
    gap: 1.5rem;
    padding-bottom: 3rem;
  }

  .ficha {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .ficha > * {
    margin: 0;
  }

  .estado {
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .estado-disponible {
    color: var(--color-acento);
  }

  .estado-reservada,
  .estado-vendida {
    color: var(--color-secundario);
    opacity: 0.8;
  }

  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1rem;
  }

  dt {
    color: var(--color-secundario);
  }

  dd {
    margin: 0;
  }

  .precio {
    font-family: var(--fuente-titulos);
    font-size: 1.125rem;
  }

  @media (min-width: 64rem) {
    .obra {
      grid-template-columns: 3fr 2fr;
      align-items: start;
    }
  }
</style>
