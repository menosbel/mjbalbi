---
import { getCollection, getEntry, render } from 'astro:content';
import EtiquetaEstado from '../../components/EtiquetaEstado.astro';
import FotosObra from '../../components/FotosObra.astro';
import Base from '../../layouts/Base.astro';
import { consultaObra } from '../../lib/consulta';
import { ETIQUETA_TECNICA, formatMedidas, formatSoporte } from '../../lib/obras';
import { seoObra } from '../../lib/seo';
import { urlSerie } from '../../lib/urls';

export async function getStaticPaths() {
  const obras = await getCollection('obras');
  return obras.map((obra) => ({ params: { slug: obra.id }, props: { obra } }));
}

const { obra } = Astro.props;
const { titulo, fotos, medidas, tecnica, soporte, año, enmarcada, estado } = obra.data;
const { Content } = await render(obra);
const serie = obra.data.serie && (await getEntry(obra.data.serie));
// Astro solo avisa de una referencia rota; que falle el build.
if (obra.data.serie && !serie) {
  throw new Error(`obras: "${obra.id}" pertenece a la Serie "${obra.data.serie.id}", que no existe.`);
}
const consulta = consultaObra(titulo, estado);

const datos: [string, string][] = [
  ['Medidas', formatMedidas(medidas)],
  ['Técnica', ETIQUETA_TECNICA[tecnica]],
  ...(soporte ? [['Soporte', formatSoporte(soporte)] as [string, string]] : []),
  ['Año', String(año)],
  ...(enmarcada !== undefined ? [['Enmarcada', enmarcada ? 'Sí' : 'No'] as [string, string]] : []),
];
---

<Base title={titulo} {...await seoObra(obra.id, obra.data, obra.body)}>
  <article class="obra">
    <FotosObra titulo={titulo} fotos={fotos} />
    <div class="ficha">
      <h1>{titulo}</h1>
      {serie && (
        <p class="serie">
          Serie <a href={urlSerie(serie.id)}>{serie.data.nombre}</a>
        </p>
      )}
      <EtiquetaEstado estado={estado} />
      <dl>
        {
          datos.map(([termino, valor]) => (
            <>
              <dt>{termino}</dt>
              <dd>{valor}</dd>
            </>
          ))
        }
      </dl>
      <div class="descripcion">
        <Content />
      </div>
      <p class="precio">Consultar precio</p>
      <a class="consulta" href={consulta.href}>{consulta.texto}</a>
    </div>
  </article>
</Base>

<style>
  .obra {
    display: grid;
    gap: 1.5rem;
    padding-bottom: 3rem;
  }

  .ficha {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .ficha > * {
    margin: 0;
  }

  .serie,
  .serie a {
    color: var(--color-secundario);
  }

  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1rem;
  }

  dt {
    color: var(--color-secundario);
  }

  dd {
    margin: 0;
  }

  .precio {
    font-family: var(--fuente-titulos);
    font-size: 1.125rem;
  }

  .consulta {
    justify-self: start;
    padding: 0.75rem 1.25rem;
    border-radius: 2px;
    background: var(--color-acento);
    color: var(--color-fondo);
    text-decoration: none;
  }

  .consulta:hover {
    filter: brightness(0.92);
  }

  @media (min-width: 64rem) {
    .obra {
      grid-template-columns: 3fr 2fr;
      align-items: start;
    }
  }
</style>
